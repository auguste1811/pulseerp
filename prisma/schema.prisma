generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                         String                  @id @default(cuid())
  firstName                  String                  @default("") @map("first_name")
  lastName                   String                  @default("") @map("last_name")
  email                      String                  @unique
  passwordHash               String                  @default("") @map("password_hash")
  googleId                   String?                 @unique @map("google_id")
  isActive                   Boolean                 @default(true) @map("is_active")
  emailVerified              DateTime?               @map("email_verified_at") @db.Timestamptz(6)
  lastLoginAt                DateTime?               @map("last_login_at") @db.Timestamptz(6)
  createdAt                  DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  name                       String?
  image                      String?
  isPlatformAdmin            Boolean                 @default(false) @map("is_platform_admin")
  managedAcquisitionChannels AcquisitionChannel[]    @relation("AcquisitionManager")
  aiConversations            AiConversation[]
  accounts                   Account[]
  sessions                   Session[]
  automations                Automation[]
  assignedEvents             CalendarEvent[]         @relation("EventAssignee")
  createdEvents              CalendarEvent[]         @relation("EventCreator")
  memberships                CompanyMember[]
  activities                 ContactActivity[]
  notes                      ContactNote[]
  assignedContacts           Contact[]               @relation("ContactAssignee")
  crmCallsCreated            CrmCall[]               @relation("CrmCallCreator")
  uploadedDocuments          Document[]
  integrations               IntegrationConnection[]
  invitations                Invitation[]
  notifications              Notification[]
  uploadedPurchaseInvoices   PurchaseInvoice[]
  sales_document_emails      sales_document_emails[]
  createdDocuments           SalesDocument[]         @relation("SalesDocumentCreator")
  assignedTasks              Task[]                  @relation("TaskAssignee")

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refreshToken      String? @map("refresh_token")
  accessToken       String? @map("access_token")
  expiresAt         Int?    @map("expires_at")
  tokenType         String? @map("token_type")
  scope             String?
  idToken           String? @map("id_token")
  sessionState      String? @map("session_state")
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("auth_accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime @db.Timestamptz(6)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime @db.Timestamptz(6)

  @@unique([identifier, token])
  @@map("auth_verification_tokens")
}

model PasswordResetToken {
  id         String   @id @default(cuid())
  identifier String
  tokenHash  String   @unique @map("token_hash")
  expires    DateTime @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([identifier])
  @@map("password_reset_tokens")
}

model Company {
  id                    String                  @id
  name                  String
  currency              String                  @default("EUR")
  defaultVatRate        Decimal                 @default(20) @map("default_vat_rate") @db.Decimal
  createdAt             DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  legalName             String?                 @map("legal_name")
  address               String?
  postalCode            String?                 @map("postal_code")
  city                  String?
  country               String                  @default("France")
  email                 String?
  phone                 String?
  website               String?
  siret                 String?
  vatNumber             String?                 @map("vat_number")
  iban                  String?
  bic                   String?
  invoiceFooter         String?                 @map("invoice_footer")
  logoUrl               String?                 @map("logo_url") @db.Text
  paymentTermsDays      Int                     @default(30) @map("payment_terms_days")
  quoteValidityDays     Int                     @default(30) @map("quote_validity_days")
  quotePrefix           String                  @default("DEV") @map("quote_prefix")
  invoicePrefix         String                  @default("FAC") @map("invoice_prefix")
  creditPrefix          String                  @default("AVO") @map("credit_prefix")
  updatedAt             DateTime                @default(now()) @map("updated_at") @db.Timestamptz(6)
  status                String                  @default("ACTIVE")
  accessExpiresAt       DateTime?               @map("access_expires_at") @db.Timestamptz(6)
  accountingEntries     AccountingEntry[]
  acquisitionChannels   AcquisitionChannel[]
  aiConversations       AiConversation[]
  automationRuns        AutomationRun[]
  automations           Automation[]
  calendarEvents        CalendarEvent[]
  members               CompanyMember[]
  enabledModules        CompanyModule[]
  contactActivities     ContactActivity[]
  contactGroups         ContactGroup[]
  contactNotes          ContactNote[]
  contacts              Contact[]
  crmCalls              CrmCall[]
  documentSequences     DocumentSequence[]
  documents             Document[]
  integrations          IntegrationConnection[]
  invitations           Invitation[]
  notifications         Notification[]
  purchaseInvoices      PurchaseInvoice[]
  sales_document_emails sales_document_emails[]
  salesDocuments        SalesDocument[]
  subscription          Subscription?
  tasks                 Task[]
  transactions          Transaction[]

  @@map("companies")
}

model CompanyMember {
  userId    String  @map("user_id")
  companyId String  @map("company_id")
  role      String  @default("EMPLOYEE")
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([userId, companyId])
  @@map("company_members")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model Contact {
  id               String               @id
  companyId        String               @map("company_id")
  firstName        String               @map("first_name")
  lastName         String               @map("last_name")
  companyName      String?              @map("company_name")
  email            String?
  phone            String?
  source           String?
  status           String               @default("PROSPECT")
  value            Decimal              @default(0) @db.Decimal
  address          String?
  siret            String?
  vatNumber        String?              @map("vat_number")
  priority         String               @default("MEDIUM")
  tags             String[]             @default([])
  assignedUserId   String?              @map("assigned_user_id")
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime             @default(now()) @map("updated_at") @db.Timestamptz(6)
  events           CalendarEvent[]
  activities       ContactActivity[]
  groupMemberships ContactGroupMember[]
  notes            ContactNote[]
  assignedUser     User?                @relation("ContactAssignee", fields: [assignedUserId], references: [id], onUpdate: NoAction)
  company          Company              @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  calls            CrmCall[]
  documents        Document[]
  salesDocs        SalesDocument[]

  @@index([companyId, status], map: "contacts_company_status_idx")
  @@map("contacts")
}

model ContactNote {
  id        String   @id
  companyId String   @map("company_id")
  contactId String   @map("contact_id")
  authorId  String   @map("author_id")
  content   String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([companyId, contactId, createdAt(sort: Desc)], map: "contact_notes_contact_idx")
  @@map("contact_notes")
}

model ContactActivity {
  id          String   @id
  companyId   String   @map("company_id")
  contactId   String   @map("contact_id")
  actorId     String?  @map("actor_id")
  type        String
  title       String
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  actor       User?    @relation(fields: [actorId], references: [id], onUpdate: NoAction)
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  contact     Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([companyId, contactId, createdAt(sort: Desc)], map: "contact_activities_contact_idx")
  @@map("contact_activities")
}

model Transaction {
  id                 String           @id
  companyId          String           @map("company_id")
  type               String
  status             String           @default("PENDING")
  date               DateTime         @db.Date
  label              String
  category           String?
  amountExcludingTax Decimal          @map("amount_excluding_tax") @db.Decimal
  vatRate            Decimal          @map("vat_rate") @db.Decimal
  vatAmount          Decimal          @map("vat_amount") @db.Decimal
  amountIncludingTax Decimal          @map("amount_including_tax") @db.Decimal
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  salesDocumentId    String?          @unique @map("sales_document_id")
  purchaseInvoiceId  String?          @unique @map("purchase_invoice_id")
  revenueSource      String?          @map("revenue_source")
  company            Company          @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  purchaseInvoice    PurchaseInvoice? @relation(fields: [purchaseInvoiceId], references: [id])
  salesDocument      SalesDocument?   @relation(fields: [salesDocumentId], references: [id])

  @@map("transactions")
}

model Task {
  id             String    @id
  companyId      String    @map("company_id")
  title          String
  description    String?
  status         String    @default("TODO")
  priority       String    @default("MEDIUM")
  dueDate        DateTime? @map("due_date") @db.Date
  assignedUserId String?   @map("assigned_user_id")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  assignedUser   User?     @relation("TaskAssignee", fields: [assignedUserId], references: [id], onUpdate: NoAction)
  company        Company   @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([companyId, assignedUserId, status], map: "tasks_company_assignee_idx")
  @@map("tasks")
}

model CalendarEvent {
  id                String    @id
  companyId         String    @map("company_id")
  contactId         String?   @map("contact_id")
  assignedUserId    String?   @map("assigned_user_id")
  title             String
  description       String?
  eventType         String    @default("MEETING") @map("event_type")
  status            String    @default("PLANNED")
  startAt           DateTime  @map("start_at") @db.Timestamptz(6)
  endAt             DateTime  @map("end_at") @db.Timestamptz(6)
  location          String?
  reminderMinutes   Int       @default(30) @map("reminder_minutes")
  createdBy         String?   @map("created_by")
  externalProvider  String?   @map("external_provider")
  externalId        String?   @map("external_id")
  externalUrl       String?   @map("external_url")
  externalUpdatedAt DateTime? @map("external_updated_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  assignedUser      User?     @relation("EventAssignee", fields: [assignedUserId], references: [id], onUpdate: NoAction)
  company           Company   @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  contact           Contact?  @relation(fields: [contactId], references: [id], onUpdate: NoAction)
  creator           User?     @relation("EventCreator", fields: [createdBy], references: [id], onUpdate: NoAction)

  @@index([companyId, startAt], map: "calendar_events_company_start_idx")
  @@index([companyId, contactId], map: "calendar_events_contact_idx")
  @@map("calendar_events")
}

model SalesDocument {
  id                    String                  @id
  companyId             String                  @map("company_id")
  contactId             String?                 @map("contact_id")
  documentType          String                  @map("document_type")
  documentNumber        String                  @map("document_number")
  status                String                  @default("DRAFT")
  issueDate             DateTime                @default(dbgenerated("CURRENT_DATE")) @map("issue_date") @db.Date
  dueDate               DateTime?               @map("due_date") @db.Date
  validUntil            DateTime?               @map("valid_until") @db.Date
  currency              String                  @default("EUR")
  notes                 String?
  subtotal              Decimal                 @default(0) @db.Decimal
  vatAmount             Decimal                 @default(0) @map("vat_amount") @db.Decimal
  total                 Decimal                 @default(0) @db.Decimal
  sourceQuoteId         String?                 @map("source_quote_id")
  sourceInvoiceId       String?                 @map("source_invoice_id")
  signedAt              DateTime?               @map("signed_at") @db.Timestamptz(6)
  signedBy              String?                 @map("signed_by")
  createdBy             String?                 @map("created_by")
  createdAt             DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                @default(now()) @map("updated_at") @db.Timestamptz(6)
  sales_document_emails sales_document_emails[]
  items                 SalesDocumentItem[]
  company               Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  contact               Contact?                @relation(fields: [contactId], references: [id], onUpdate: NoAction)
  creator               User?                   @relation("SalesDocumentCreator", fields: [createdBy], references: [id], onUpdate: NoAction)
  sourceQuote           SalesDocument?          @relation("QuoteConversion", fields: [sourceQuoteId], references: [id], onUpdate: NoAction)
  derivedDocs           SalesDocument[]         @relation("QuoteConversion")
  accountingTransaction Transaction?

  @@unique([companyId, documentNumber])
  @@index([companyId, documentType, issueDate(sort: Desc)], map: "sales_documents_company_type_idx")
  @@index([companyId, contactId], map: "sales_documents_contact_idx")
  @@map("sales_documents")
}

model SalesDocumentItem {
  id           String        @id
  documentId   String        @map("document_id")
  description  String
  quantity     Decimal       @default(1) @db.Decimal
  unitPrice    Decimal       @default(0) @map("unit_price") @db.Decimal
  vatRate      Decimal       @default(20) @map("vat_rate") @db.Decimal
  lineSubtotal Decimal       @default(0) @map("line_subtotal") @db.Decimal
  lineVat      Decimal       @default(0) @map("line_vat") @db.Decimal
  lineTotal    Decimal       @default(0) @map("line_total") @db.Decimal
  position     Int           @default(0)
  document     SalesDocument @relation(fields: [documentId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([documentId, position], map: "sales_document_items_document_idx")
  @@map("sales_document_items")
}

model DocumentSequence {
  companyId    String  @map("company_id")
  documentType String  @map("document_type")
  year         Int
  currentValue Int     @default(0) @map("current_value")
  company      Company @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([companyId, documentType, year])
  @@map("document_sequences")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model Invitation {
  id         String    @id
  companyId  String    @map("company_id")
  email      String
  role       String    @default("EMPLOYEE")
  token      String    @unique
  invitedBy  String?   @map("invited_by")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  inviter    User?     @relation(fields: [invitedBy], references: [id], onUpdate: NoAction)

  @@map("invitations")
}

model Document {
  id           String   @id
  companyId    String   @map("company_id")
  contactId    String?  @map("contact_id")
  uploadedBy   String?  @map("uploaded_by")
  name         String
  originalName String   @map("original_name")
  storageKey   String   @map("storage_key")
  mimeType     String   @map("mime_type")
  sizeBytes    BigInt   @map("size_bytes")
  category     String   @default("OTHER")
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  contact      Contact? @relation(fields: [contactId], references: [id], onUpdate: NoAction)
  uploader     User?    @relation(fields: [uploadedBy], references: [id], onUpdate: NoAction)

  @@index([companyId, createdAt(sort: Desc)], map: "documents_company_created_idx")
  @@index([companyId, contactId], map: "documents_contact_idx")
  @@map("documents")
}

model IntegrationConnection {
  id                    String    @id
  companyId             String    @map("company_id")
  userId                String?   @map("user_id")
  provider              String
  accountEmail          String?   @map("account_email")
  accountName           String?   @map("account_name")
  encryptedAccessToken  String?   @map("encrypted_access_token")
  encryptedRefreshToken String?   @map("encrypted_refresh_token")
  tokenExpiresAt        DateTime? @map("token_expires_at") @db.Timestamptz(6)
  scopes                String[]  @default([])
  status                String    @default("CONNECTED")
  settings              Json      @default("{}")
  lastSyncAt            DateTime? @map("last_sync_at") @db.Timestamptz(6)
  lastSyncStatus        String?   @map("last_sync_status")
  lastError             String?   @map("last_error")
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  company               Company   @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user                  User?     @relation(fields: [userId], references: [id], onUpdate: NoAction)

  @@unique([companyId, provider])
  @@index([companyId, provider, status], map: "integration_connections_company_idx")
  @@map("integration_connections")
}

model Automation {
  id            String          @id
  companyId     String          @map("company_id")
  name          String
  description   String?
  triggerType   String          @map("trigger_type")
  triggerConfig Json            @default("{}") @map("trigger_config")
  conditions    Json            @default("[]")
  actions       Json            @default("[]")
  isActive      Boolean         @default(false) @map("is_active")
  createdBy     String?         @map("created_by")
  lastRunAt     DateTime?       @map("last_run_at") @db.Timestamptz(6)
  lastRunStatus String?         @map("last_run_status")
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime        @default(now()) @map("updated_at") @db.Timestamptz(6)
  runs          AutomationRun[]
  company       Company         @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  creator       User?           @relation(fields: [createdBy], references: [id], onUpdate: NoAction)

  @@index([companyId, isActive], map: "automations_company_active_idx")
  @@index([companyId, triggerType], map: "automations_company_trigger_idx")
  @@map("automations")
}

model AutomationRun {
  id             String     @id
  companyId      String     @map("company_id")
  automationId   String     @map("automation_id")
  triggerPayload Json       @default("{}") @map("trigger_payload")
  status         String     @default("RUNNING")
  logs           Json       @default("[]")
  errorMessage   String?    @map("error_message")
  startedAt      DateTime   @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt     DateTime?  @map("finished_at") @db.Timestamptz(6)
  automation     Automation @relation(fields: [automationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  company        Company    @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([automationId, startedAt(sort: Desc)], map: "automation_runs_automation_idx")
  @@index([companyId, startedAt(sort: Desc)], map: "automation_runs_company_started_idx")
  @@map("automation_runs")
}

model Notification {
  id        String   @id
  companyId String   @map("company_id")
  userId    String?  @map("user_id")
  title     String
  message   String
  type      String   @default("INFO")
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId, isRead, createdAt(sort: Desc)], map: "notifications_user_read_idx")
  @@map("notifications")
}

model PurchaseInvoice {
  id            String            @id @default(cuid())
  companyId     String            @map("company_id")
  uploadedBy    String?           @map("uploaded_by")
  supplierName  String            @map("supplier_name")
  invoiceNumber String?           @map("invoice_number")
  issueDate     DateTime          @map("issue_date") @db.Date
  dueDate       DateTime?         @map("due_date") @db.Date
  category      String            @default("TO_CLASSIFY")
  status        String            @default("PENDING")
  subtotal      Decimal           @default(0)
  vatAmount     Decimal           @default(0) @map("vat_amount")
  total         Decimal           @default(0)
  notes         String?
  originalName  String            @map("original_name")
  mimeType      String            @map("mime_type")
  sizeBytes     Int               @map("size_bytes")
  fileData      Bytes             @map("file_data")
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  ocrStatus     String            @default("NOT_ANALYZED") @map("ocr_status")
  ocrConfidence Decimal?          @map("ocr_confidence") @db.Decimal(5, 4)
  ocrData       Json?             @map("ocr_data")
  ocrError      String?           @map("ocr_error")
  ocrAnalyzedAt DateTime?         @map("ocr_analyzed_at") @db.Timestamptz(6)
  entries       AccountingEntry[]
  company       Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  uploader      User?             @relation(fields: [uploadedBy], references: [id])
  transaction   Transaction?

  @@index([companyId, issueDate(sort: Desc)])
  @@index([companyId, category, status])
  @@index([companyId, ocrStatus], map: "purchase_invoices_company_ocr_status_idx")
  @@map("purchase_invoices")
}

model AccountingEntry {
  id                String           @id @default(cuid())
  companyId         String           @map("company_id")
  purchaseInvoiceId String?          @map("purchase_invoice_id")
  entryDate         DateTime         @map("entry_date") @db.Date
  journal           String
  accountNumber     String           @map("account_number")
  label             String
  debit             Decimal          @default(0)
  credit            Decimal          @default(0)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  company           Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  purchaseInvoice   PurchaseInvoice? @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)

  @@index([companyId, entryDate(sort: Desc)])
  @@index([purchaseInvoiceId])
  @@map("accounting_entries")
}

model AiConversation {
  id        String      @id @default(cuid())
  companyId String      @map("company_id")
  userId    String?     @map("user_id")
  title     String      @default("Nouvelle conversation")
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  company   Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User?       @relation(fields: [userId], references: [id])
  messages  AiMessage[]

  @@index([companyId, updatedAt(sort: Desc)])
  @@index([userId])
  @@map("ai_conversations")
}

model AiMessage {
  id             String         @id @default(cuid())
  conversationId String         @map("conversation_id")
  role           String
  content        String
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("ai_messages")
}

model Subscription {
  id                   String    @id @default(cuid())
  companyId            String    @unique @map("company_id")
  plan                 String    @default("TRIAL")
  status               String    @default("TRIALING")
  trialStartsAt        DateTime  @default(now()) @map("trial_starts_at") @db.Timestamptz(6)
  trialEndsAt          DateTime  @map("trial_ends_at") @db.Timestamptz(6)
  stripeCustomerId     String?   @map("stripe_customer_id")
  stripeSubscriptionId String?   @map("stripe_subscription_id")
  stripePriceId        String?   @map("stripe_price_id")
  currentPeriodEnd     DateTime? @map("current_period_end") @db.Timestamptz(6)
  cancelAtPeriodEnd    Boolean   @default(false) @map("cancel_at_period_end")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  company              Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([status, trialEndsAt])
  @@map("subscriptions")
}

model AppModule {
  id          String          @id @default(cuid())
  code        String          @unique
  name        String
  description String?
  category    String
  route       String?
  icon        String?
  position    Int             @default(0)
  isActive    Boolean         @default(true) @map("is_active")
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  companies   CompanyModule[]

  @@map("app_modules")
}

model CompanyModule {
  companyId String    @map("company_id")
  moduleId  String    @map("module_id")
  enabled   Boolean   @default(true)
  expiresAt DateTime? @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  module    AppModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@id([companyId, moduleId])
  @@index([companyId, enabled])
  @@map("company_modules")
}

model AcquisitionChannel {
  id            String              @id @default(cuid())
  companyId     String              @map("company_id")
  code          String
  name          String
  managerUserId String?             @map("manager_user_id")
  isActive      Boolean             @default(true) @map("is_active")
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  company       Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  manager       User?               @relation("AcquisitionManager", fields: [managerUserId], references: [id])
  metrics       AcquisitionMetric[]

  @@unique([companyId, code])
  @@index([companyId, isActive])
  @@map("acquisition_channels")
}

model AcquisitionMetric {
  id                String             @id @default(cuid())
  channelId         String             @map("channel_id")
  month             DateTime           @db.Date
  spend             Decimal            @default(0) @db.Decimal(14, 2)
  attributedRevenue Decimal            @default(0) @map("attributed_revenue") @db.Decimal(14, 2)
  notes             String?
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  channel           AcquisitionChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, month])
  @@index([month])
  @@map("acquisition_metrics")
}

model CrmCall {
  id              String    @id @default(cuid())
  companyId       String    @map("company_id")
  contactId       String    @map("contact_id")
  createdById     String    @map("created_by_id")
  direction       String    @default("OUTBOUND")
  status          String
  outcome         String?
  startedAt       DateTime  @map("started_at") @db.Timestamptz(6)
  durationSeconds Int       @default(0) @map("duration_seconds")
  phoneNumber     String?   @map("phone_number")
  summary         String?
  nextAction      String?   @map("next_action")
  followUpAt      DateTime? @map("follow_up_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact         Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  createdBy       User      @relation("CrmCallCreator", fields: [createdById], references: [id])

  @@index([companyId, startedAt])
  @@index([contactId, startedAt])
  @@map("crm_calls")
}

model ContactGroup {
  id          String               @id @default(cuid())
  companyId   String               @map("company_id")
  name        String
  description String?
  color       String               @default("#6653E8")
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  members     ContactGroupMember[]
  company     Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, name])
  @@index([companyId])
  @@map("contact_groups")
}

model ContactGroupMember {
  groupId   String       @map("group_id")
  contactId String       @map("contact_id")
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  contact   Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  group     ContactGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([groupId, contactId])
  @@index([contactId])
  @@map("contact_group_members")
}

model sales_document_emails {
  id              String        @id
  company_id      String
  document_id     String
  recipient       String
  subject         String
  status          String
  provider_id     String?
  error_message   String?
  sent_by         String?
  sent_at         DateTime?     @db.Timestamptz(6)
  created_at      DateTime      @default(now()) @db.Timestamptz(6)
  companies       Company       @relation(fields: [company_id], references: [id], onDelete: Cascade)
  sales_documents SalesDocument @relation(fields: [document_id], references: [id], onDelete: Cascade)
  users           User?         @relation(fields: [sent_by], references: [id])

  @@index([company_id, created_at(sort: Desc)])
  @@index([document_id, created_at(sort: Desc)])
}

model DocumentPayment {
  id         String   @id @default(cuid())
  companyId  String   @map("company_id")
  documentId String   @map("document_id")
  amount     Decimal  @default(0) @db.Decimal
  paidAt     DateTime @default(dbgenerated("CURRENT_DATE")) @map("paid_at") @db.Date
  method     String?
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([documentId, paidAt])
  @@map("document_payments")
}
